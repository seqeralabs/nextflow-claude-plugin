/*
 * Resource-tier definitions.
 *
 * Modules declare a `label 'process_single' | 'process_low' | ...` and this
 * file maps each label to concrete cpus/memory/time/machineType values.
 * That way operators can tune compute cost from one place instead of
 * editing every module.
 *
 * Override in a site-specific config (or on the CLI with `-c`) to adapt
 * to a particular executor — e.g. on AWS Batch you can add
 * `machineType = 'c7i.2xlarge'` for the higher tiers.
 */

process {
    // Generic retry policy so transient failures don't kill the pipeline.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'terminate' }
    maxRetries    = 1

    // Cap resource requests to the largest available infrastructure.
    // Override in a site-specific config / profile to match your environment.
    resourceLimits = [
        cpus:   12,
        memory: 128.GB,
        time:   24.h
    ]

    withLabel: 'process_single' {
        cpus   = 1
        memory = 1.GB
        time   = 30.min
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: 'process_medium' {
        cpus   = 6
        memory = 24.GB
        time   = 6.h
    }
    withLabel: 'process_high' {
        cpus   = 12
        memory = 64.GB
        time   = 12.h
    }
    withLabel: 'process_high_memory' {
        cpus   = 6
        memory = 128.GB
        time   = 12.h
    }
}
