// Example pipeline configuration.
//
// Per-process publish directives live here (not in the module) so modules
// stay free of params references. Resource tiers live in conf/base.config
// so compute cost can be tuned from one place. This mirrors the nf-core
// convention.

// DSL2 is the default in Nextflow ≥ 23 — do NOT add nextflow.enable.dsl = 2

// Enable typed processes/workflows (input:/output:/topic:/stage: sections with
// type annotations). Requires Nextflow 26.04+ (strict syntax is the default;
// no NXF_SYNTAX_PARSER env var needed).
nextflow.enable.types = true

// nf-schema: --help generation and schema validation for launch surfaces.
// main.nf also declares typed params, so Nextflow 26.04 validates types natively.
plugins {
    id 'nf-schema@2.7.2'
}


// Resource-tier definitions driven by process labels. Override in a
// site-specific config (or on the CLI with `-c`) to adapt to an executor.
includeConfig 'conf/base.config'

// Container execution. Wave + Docker is the recommended path: every
// module declares a `container` directive; Wave mirrors / caches the
// image and Docker (or Singularity on HPC) runs it. Override with
// `-c <site>.config` to switch to Singularity, Podman, or a private
// registry without touching the module definitions.
docker {
    enabled = true
}
wave {
    enabled = true
}

process {
    withName: 'SPLIT_FASTA' {
        publishDir = [path: { "${params.outdir}/split" }, mode: 'copy']
    }

    withName: 'VALIDATE_SEQUENCE' {
        publishDir = [path: { "${params.outdir}/validated" }, mode: 'copy']
    }

    withName: 'COMPUTE_GC_CONTENT' {
        publishDir = [path: { "${params.outdir}/gc" }, mode: 'copy']
    }

    withName: 'COMPUTE_KMER_PROFILE' {
        publishDir = [path: { "${params.outdir}/kmer" }, mode: 'copy']
    }

    withName: 'GENERATE_SUMMARY' {
        publishDir = [path: { "${params.outdir}/summary" }, mode: 'copy']
    }

    withName: 'RENDER_REPORT' {
        publishDir = [path: { "${params.outdir}/report" }, mode: 'copy']
    }
}

manifest {
    name        = 'nflint-example-pipeline'
    description = 'Fast FASTA composition pipeline used as a reference implementation.'
    version     = '0.1.0'
}
